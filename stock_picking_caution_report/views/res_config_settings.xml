<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='operations_setting_container']" position="inside">
                <div
                    class="col-12 col-lg-12 o_setting_box"
                    id="caution_report_disclaimer_config"
                    groups="stock.group_stock_manager"
                >
                    <div class="o_setting_right_pane">
                        <label
                            for="caution_report_disclaimer"
                            string="Caution Report Disclaimer"
                        />
                        <div class="text-muted">
                            Insert the company default Caution Report Disclaimer.
                        </div>
                        <div class="content-group">
                            <field
                                name="caution_report_disclaimer"
                                class="o_light_label"
                            />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
