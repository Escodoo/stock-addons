    </template>
    <template id="caution_document_report">
        <t t-foreach="docs" t-as="o">
            <t t-if="o.equipment_request_id">
                <t
                    t-call="stock_picking_caution_report.caution_report_stock_equipament_personal"
                    t-lang="o.partner_id.lang or o.env.lang"
                />
            </t>
            <t t-else="">
                <t
                    t-call="stock_picking_caution_report.caution_report_stock"
                    t-lang="o.partner_id.lang or o.env.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_caution_report" model="ir.actions.report">
        <field name="name">Caution Report</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >stock_picking_caution_report.caution_document_report</field>
        <field
            name="report_file"
        >stock_picking_caution_report.caution_document_report</field>
        <field
            name="print_report_name"
        >'Caution - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>
