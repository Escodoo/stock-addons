<odoo>
    <template id="caution_report_stock">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t
                    t-set="o"
                    t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"
                />

                <div class="page" style="font-size: 10px">
                    <div class="mt-4 text-end">
                        <span>Nº Caution: <strong t-field="o.name" />
                        </span>
                        <br />
                        <span>Release: <strong t-field="o.user_id.name" />
                        </span>
                        <br />
                        <span>Date: <strong t-field="o.create_date" />
                        </span>
                    </div>
                    <br />
                    <div class="mt-4 text-center">
                        <strong>EXIT GUIDE</strong>
                        <br />
                    </div>

                    <table
                        class="table table-bordered"
                        name="info-applicant"
                        style="font-size: 10px; height:7px; border:1px;"
                    >
                        <thead />
                        <tbody>
                            <tr>
                                <td
                                    class="center-align"
                                    width="2%"
                                    style="padding: 3px;"
                                >
                                    <div class="mt-1 text-start">
                                        <span>Customer or Requester</span>
                                        <span />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 3px;">
                                    <div class="row mt-1">
                                        <div class="col-8">
                                            <span>Collaborator: <strong
                                                    t-field="o.employee_id.name"
                                                />
                                            </span>
                                        </div>
                                        <div style="clear: both;" />
                                        <div class="col-4 text-end">
                                            <span>Collaborator Code:</span>
                                            <span t-field="o.employee_id.id" />
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 3px;">
                                    <div class="row mt-1">
                                        <div class="col-8">
                                            <span>Function / Job: <strong
                                                    t-field="o.employee_id.job_id"
                                                />
                                            </span>
                                        </div>
                                        <div style="clear: both;" />
                                        <div class="col-4 text-end">
                                            <span>Departament: <strong
                                                    t-field="o.employee_id.department_id"
                                                />
                                            </span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table
                        class="table table-bordered"
                        name="info-solicitante"
                        style="font-size: 10px"
                    >
                        <thead />
                        <tbody>
                            <tr>
                                <td
                                    class="center-align"
                                    style="padding: 3px;"
                                    colspan="3"
                                >
                                    <div class="mt-1 text-start">
                                        <span>Output Data:</span>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="left-align" style="padding: 3px;">
                                    <t
                                        t-set="analytic_account_ids"
                                        t-value="[int(k) for move in o.move_ids_without_package if move.analytic_distribution for k in (move.analytic_distribution or {}).keys() if str(k).isdigit()]"
                                    />
                                    <t
                                        t-set="analytic_accounts"
                                        t-value="env['account.analytic.account'].browse(list(set(analytic_account_ids))) if analytic_account_ids else env['account.analytic.account']"
                                    />
                                    <span>
                                        Nº Contract:
                                        <t
                                            t-foreach="analytic_accounts"
                                            t-as="product_analytic"
                                        >
                                            <strong t-field="product_analytic.name" />
                                            <strong>, </strong>
                                        </t>
                                    </span>
                                </td>
                                <td class="left-align" style="padding: 3px;">
                                    <span>Purpose of Caution: <strong
                                            t-field="o.picking_type_id.name"
                                        />
                                    </span>
                                </td>
                                <td class="left-align" style="padding: 3px;">
                                    <span>Caution Status: <strong t-field="o.state" />
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mt-1" style="font-size: 12px">
                        <strong>Outgoing Items</strong>
                        <br />
                    </div>

                    <table
                        class="table"
                        name="field"
                        style="font-size:10px; height:12px; border:1px"
                    >
                        <thead>
                            <tr class="table-active table-bordered">
                                <td style="padding: 3px;">
                                    <span>Code</span>
                                </td>
                                <td style="padding: 3px;">
                                    <span>Description</span>
                                </td>
                                <td style="padding: 3px;">
                                    <span>Unit</span>
                                </td>
                                <td style="padding: 3px;">
                                    <span>Quant.</span>
                                </td>
                                <td style="padding: 3px;">
                                    <span>Price</span>
                                </td>
                                <td style="padding: 3px;">
                                    <span>Total</span>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.move_ids_without_package" t-as="product">
                                <t t-foreach="product.move_line_ids" t-as="move_line">
                                    <t t-set="lot" t-value="move_line.lot_id" />
                                    <tr>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.default_code"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.name"
                                                />
                                            </strong>
                                            <t t-if="lot">
                                                <br />
                                            (Lote/Série: <span t-esc="lot.name" />)
                                            </t>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.uom_id"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span t-field="move_line.qty_done" />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.standard_price"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-esc="move_line.qty_done * product.product_id.standard_price"
                                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                />
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not product.move_line_ids">
                                    <tr>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.default_code"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.name"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.uom_id"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;" />
                                        <td style="padding: 3px;" />
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_uom_qty"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-field="product.product_id.standard_price"
                                                />
                                            </strong>
                                        </td>
                                        <td style="padding: 3px;">
                                            <strong>
                                                <span
                                                    t-esc="product.product_uom_qty * product.product_id.standard_price"
                                                />
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <t t-set="total_qty" t-value="0" />
                            <t t-set="total_price" t-value="0" />
                            <t t-foreach="o.move_ids_without_package" t-as="product">
                                <t
                                    t-set="total_qty"
                                    t-value="total_qty + product.quantity_done"
                                />
                                <t
                                    t-set="total_price"
                                    t-value="total_price + (product.quantity_done * product.product_id.standard_price)"
                                />
                            </t>
                            <tr class="table-active table-bordered">
                                <td colspan="3">
                                    <strong>Total</strong>
                                </td>
                                <td colspan="2">
                                    <strong>
                                        <span t-esc="total_qty" />
                                    </strong>
                                </td>
                                <td style="padding: 3px;">
                                    <strong>
                                        <span
                                            t-esc="total_price"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row mt-1" style="font-size: 10px">
                        <div class="col-6">
                            <span>Local: <strong
                                    t-field="o.company_id.partner_id.city"
                                />
                            </span>
                        </div>
                        <div class="col-6 text-end">
                            <span>Date: <strong t-field="o.create_date" />
                            </span>
                        </div>
                    </div>

                    <div class="mt-4" t-if="o.company_id.caution_report_disclaimer">
                        <p style="font-size: 10px">
                            <span>"Disclaimer"</span>
                            <br />
                            <span t-field="o.company_id.caution_report_disclaimer" />
                        </p>
                    </div>

                    <div style="clear: both;" />

                    <div class="row mt-2" style="font-size: 10px">
                        <div class="col-6 text-start" colspan="2">
                            <span>Requester: <strong
                                    t-field="o.user_id.partner_id.name"
                                />
                            </span>
                        </div>
                        <div class="col-6 text-end">
                            <span
                            >_______________________________________________________________________________</span>
                        </div>
                    </div>
                    <div style="clear: both;" />
                    <div class="row mt-2">
                        <div
                            class="col-6 text-start"
                            colspan="2"
                            style="font-size: 10px"
                        >
                            <span>Transporter: <strong
                                    t-field="o.user_id.partner_id.name"
                                />
                            </span>
                        </div>
                        <div class="col-6 text-end">
                            <span
                            >_______________________________________________________________________________</span>
                        </div>
                    </div>
                    <br />
                    <table class="table table-bordered" name="observacao">
                        <tbody>
                            <tr>
                                <td width="10%" height="50">Observations <span
                                        t-field="o.note"
                                    />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

